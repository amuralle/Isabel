# Discord bot token. Prefer setting this in config.json OR here, depending on
# your deployment style. Do not commit a real token.
DISCORD_BOT_TOKEN=DISCORD_BOT_TOKEN_PLACEHOLDER

# Optional OpenAI API key for /ask_isabel.
OPENAI_API_KEY=

# Optional Xbox API key for direct gamertag -> XUID resolution.
XBOX_API_KEY=

# Halo/spnkr token file. Keep the real file ignored.
TOKEN_FILE_PATH=config/tokens.json

# Optional Halo/spnkr Azure app credentials.
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_REDIRECT_URI=http://localhost:8000/callback
